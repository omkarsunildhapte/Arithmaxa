{
  "name": "arithmaxa-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "assets": "npx capacitor-assets generate --assetPath public",
    "android:run": "npm run build && npm run assets && npx cap sync android && npx cap open android",
    "ios:run": "npm run build && npm run assets && npx cap sync ios && npx cap open ios"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/angular": "^8.8.16",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.0",
    "swiper": "^14.0.7",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.25",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
