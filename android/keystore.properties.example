# Copy this file to keystore.properties (same folder) and fill in your own
# values after generating a release keystore — e.g. via Android Studio's
# Build > Generate Signed Bundle / APK wizard, or `keytool -genkeypair`.
#
# keystore.properties is git-ignored and must never be committed. Neither
# should the .jks/.keystore file itself — put it somewhere outside this
# repo (or in android/, which is also git-ignored for *.jks/*.keystore) and
# point storeFile at it, e.g. an absolute path or one relative to android/.

storeFile=../arithmaxa-release.jks
storePassword=
keyAlias=
keyPassword=
